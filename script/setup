#!/bin/sh
# Instala las dependencias de Ruby necesarias para compilar el sitio.
#
# Dentro de Claude Code no hace falta llamarlo a mano: el hook de arranque
# (.claude/hooks/session-start.sh) hace lo mismo al abrir la sesión.

set -e

cd "$(dirname "$0")/.."

BUNDLE_PATH="${BUNDLE_PATH:-vendor/bundle}"
export BUNDLE_PATH

# Gemfile.lock se generó con Bundler 2.5.22. Bundler 1.x falla en Ruby >= 3.2
# con "undefined method 'untaint'", así que no lo dejamos elegir solo.
if [ -z "${BUNDLER_VERSION:-}" ] && gem list -i -v 2.5.22 bundler >/dev/null 2>&1; then
  BUNDLER_VERSION=2.5.22
  export BUNDLER_VERSION
fi

echo "==> Instalando las gemas en $BUNDLE_PATH..."
bundle install --quiet

echo "==> Listo. Compila con: script/cibuild"
