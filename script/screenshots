#!/usr/bin/env bash
# Genera una imagen PNG de cada diapositiva para revisarlas visualmente.
#
# Uso:  script/screenshots [directorio-de-salida]
# Salida por defecto: .preview/  (ignorado por git)
#
# No instala nada: compila el sitio con Jekyll, lo sirve con el servidor HTTP
# de Python y lo fotografía con el Chromium que ya está en el entorno.

set -uo pipefail

cd "$(dirname "$0")/.."

OUT="${1:-.preview}"
PORT="${PREVIEW_PORT:-4321}"

export BUNDLE_PATH="${BUNDLE_PATH:-vendor/bundle}"
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

# Busca un Chromium utilizable. El orden importa: en los runners de Ubuntu,
# `chromium` es un paquete snap cuyo lanzador se queda esperando a snapd
# indefinidamente, así que descartamos cualquier ruta bajo /snap y preferimos
# el Chrome instalado como paquete normal.
CHROME=""
for candidate in \
  /opt/pw-browsers/chromium \
  "$(command -v google-chrome 2>/dev/null)" \
  "$(command -v google-chrome-stable 2>/dev/null)" \
  "$(command -v chromium 2>/dev/null)" \
  "$(command -v chromium-browser 2>/dev/null)"; do
  case "$candidate" in
    /snap/*) continue ;;
  esac
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    CHROME="$candidate"
    break
  fi
done

if [ -z "$CHROME" ]; then
  echo "ERROR: no encontré Chromium. No puedo generar las imágenes." >&2
  exit 1
fi
echo "==> Navegador: $CHROME"

echo "==> Compilando el sitio..."
bundle exec jekyll build --quiet || {
  echo "ERROR: el build de Jekyll falló. Arréglalo antes de pedir la vista previa." >&2
  exit 1
}

# Contamos el marcador que index.html emite exactamente una vez por
# diapositiva. Contar '<section' es frágil: lo emiten también la sección
# `overview` opcional y cualquier HTML suelto que alguien escriba dentro de una
# diapositiva, y entonces el recuento sale inflado.
#
# Ojo con `grep -c ... || echo 0`: cuando no hay coincidencias grep YA imprime
# "0" y además sale con 1, así que el `|| echo 0` añadía un segundo 0 y la
# variable acababa valiendo "0\n0", que rompe toda comparación numérica.
SLIDES=$(grep -c 'class="page-break"' _site/index.html) || SLIDES=0
if [ "$SLIDES" -lt 1 ]; then
  echo "ERROR: el sitio no tiene diapositivas." >&2
  exit 1
fi
echo "==> $SLIDES diapositivas detectadas."

rm -rf "$OUT"
mkdir -p "$OUT"

PROFILE=""
SERVER_PID=""
cleanup() {
  [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null
  [ -n "$PROFILE" ] && rm -rf "$PROFILE"
  return 0
}
trap cleanup EXIT INT TERM

echo "==> Sirviendo _site en el puerto $PORT..."
python3 -m http.server "$PORT" --directory _site --bind 127.0.0.1 >/dev/null 2>&1 &
SERVER_PID=$!

# Esperamos a NUESTRO servidor, y comprobamos que de verdad es el nuestro.
#
# Que el puerto responda no basta: si ya estaba ocupado, python muere al
# instante con "Address already in use" y fotografiaríamos el sitio de otro
# proceso sin enterarnos. Y mirar el PID tampoco sirve: `kill -0` devuelve
# éxito también para un proceso zombi, así que el hijo muerto parece vivo.
#
# Lo único fiable es pedir la página y reconocerla: index.html emite un
# `class="page-break"` por diapositiva, y ninguna otra cosa que pueda estar
# escuchando en ese puerto lo tendrá.
servidor_ok=0
for _ in $(seq 1 40); do
  if curl -sSf "http://127.0.0.1:$PORT/index.html" 2>/dev/null \
     | grep -q 'class="page-break"'; then
    servidor_ok=1
    break
  fi
  sleep 0.25
done
if [ "$servidor_ok" -ne 1 ]; then
  echo "ERROR: en el puerto $PORT no responde esta presentación." >&2
  echo "       Lo más probable: ese puerto ya está ocupado por otro programa." >&2
  echo "       Prueba con otro:  PREVIEW_PORT=4322 script/screenshots" >&2
  exit 1
fi

PROFILE="$(mktemp -d)"

# Chrome se cuelga indefinidamente en entornos de CI si intenta contactar el
# keyring, dbus, la primera ejecución o los servicios de red en segundo plano.
# Estos flags lo desactivan todo; el `timeout` es la red de seguridad final.
CHROME_FLAGS="
  --headless
  --disable-gpu
  --no-sandbox
  --disable-dev-shm-usage
  --no-first-run
  --no-default-browser-check
  --disable-extensions
  --disable-sync
  --disable-background-networking
  --disable-component-update
  --disable-crash-reporter
  --disable-breakpad
  --password-store=basic
  --use-mock-keychain
  --hide-scrollbars
  --window-size=1280,1024
  --virtual-time-budget=4000
"

SHOT_TIMEOUT="${SHOT_TIMEOUT:-45}"
capturadas=0
index=0
while [ "$index" -lt "$SLIDES" ]; do
  file=$(printf "%s/slide-%02d.png" "$OUT" "$((index + 1))")
  # -k: si Chrome ignora el SIGTERM, se le manda SIGKILL 10s después. Sin esto
  # `timeout` se queda esperando al proceso que no muere y el CI se cuelga.
  # shellcheck disable=SC2086
  timeout -k 10 "$SHOT_TIMEOUT" "$CHROME" $CHROME_FLAGS \
    --user-data-dir="$PROFILE/$index" \
    --screenshot="$file" \
    "http://127.0.0.1:$PORT/#/$index" \
    >/dev/null 2>&1
  estado=$?
  if [ -s "$file" ]; then
    echo "    $file"
    capturadas=$((capturadas + 1))
  elif [ "$estado" -eq 124 ]; then
    echo "    AVISO: Chrome no respondió en ${SHOT_TIMEOUT}s para la diapositiva $((index + 1)); la salto." >&2
  else
    echo "    AVISO: no se pudo capturar la diapositiva $((index + 1)) (código $estado)." >&2
  fi
  index=$((index + 1))
done
# El perfil temporal y el servidor los limpia `cleanup` en el trap, que también
# cubre Ctrl-C y SIGTERM a mitad de ejecución.

echo "==> Listo: $capturadas de $SLIDES imágenes en $OUT/"

# No fallamos si alguna captura no salió: la vista previa es una ayuda, no una
# comprobación de corrección. Quien valida el sitio es script/cibuild.
exit 0
